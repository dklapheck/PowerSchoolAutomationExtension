{
  "manifest_version": 3,
  "name": "PowerSchool OR010 + ECC/SCC Helper",
  "version": "3.2.1",
  "description": "Adds the OR010 shortcut and prepares ECC and SCC logs from locally approved Google Sheets.",
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://californiak12.powerschool.com/teachers/*"
      ],
      "js": [
        "content.js",
        "capture.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://docs.google.com/spreadsheets/*"
      ],
      "js": [
        "sheet.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "permissions": [
    "storage"
  ],
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  }
}
