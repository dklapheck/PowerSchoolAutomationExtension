{
  "manifest_version": 3,
  "name": "PowerSchool Helper",
  "version": "3.6.0",
  "description": "Adds the OR010 shortcut and prepares Demographics, ECC, and SCC workflows inside PowerSchool.",
  "content_scripts": [
    {
      "matches": [
        "https://californiak12.powerschool.com/teachers/*",
        "https://californiak12.powerschool.com/public/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "permissions": [
    "storage"
  ],
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  }
}
